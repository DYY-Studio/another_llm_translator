{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Another LLM Translator",
  "version": "0.3.0",
  "identifier": "com.anotherllm.translator",
  "build": {
    "frontendDist": "../app/web_dist",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../build/managed-runtime-dist": "managed-runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
