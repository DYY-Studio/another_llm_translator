{
  "schema_version": 2,
  "adapter_id": "anthropic",
  "messages_format": "anthropic",
  "headers": {
    "x-api-key": "${api_key}",
    "anthropic-version": "2023-06-01"
  },
  "body": {
    "model": "${model}",
    "system": "${system}",
    "messages": "${messages}",
    "max_tokens": "${max_output_tokens}",
    "temperature": "${temperature}",
    "stream": "${stream}"
  },
  "response_content_pointer": "/content/-1/text",
  "models": {
    "endpoint": "/models",
    "response_models_pointer": "/data",
    "response_model_id": "id",
    "response_model_display": "display_name"
  },
  "usage": {
    "input_tokens_pointer": "/usage/input_tokens",
    "output_tokens_pointer": "/usage/output_tokens"
  },
  "streaming": {
    "transport": "sse",
    "request_body": {},
    "content_events": [
      {
        "pointer": "/delta/text",
        "when": {"pointer": "/delta/type", "equals": "text_delta"}
      }
    ],
    "reasoning_events": [],
    "terminal": {
      "when": {"pointer": "/type", "equals": "message_stop"}
    },
    "error_events": [
      {
        "when": {"pointer": "/type", "equals": "error"},
        "message_pointer": "/error/message"
      }
    ],
    "usage": {
      "input_tokens_pointers": ["/message/usage/input_tokens"],
      "output_tokens_pointers": ["/usage/output_tokens"],
      "total_tokens_pointers": []
    }
  }
}
