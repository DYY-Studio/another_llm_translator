{
  "schema_version": 4,
  "adapter_id": "anthropic",
  "endpoint": "/messages",
  "messages_format": "anthropic",
  "headers": {
    "x-api-key": "${api_key}",
    "anthropic-version": "2023-06-01"
  },
  "body": {
    "model": "${model}",
    "system": "${system}",
    "messages": "${messages}",
    "max_tokens": "${max_output_tokens}",
    "temperature": "${temperature}",
    "stream": "${stream}"
  },
  "models": {
    "endpoint": "/models",
    "response_models_pointer": "/data",
    "response_model_id": "id",
    "response_model_display": "display_name"
  },
  "streaming": {
    "transport": "sse",
    "endpoint": "/messages",
    "request_body": {}
  },
  "reasoning_effort": {
    "body_pointer": "/output_config/effort",
    "values": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "aliases": []
  },
  "max_output_tokens_minimum": 1,
  "response_format": "anthropic",
  "structured_output": {
    "/output_config/format": {
      "type": "json_schema",
      "schema": "${json_schema}"
    }
  }
}
