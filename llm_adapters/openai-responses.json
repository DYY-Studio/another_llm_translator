{
  "schema_version": 4,
  "adapter_id": "openai-responses",
  "endpoint": "/responses",
  "headers": {
    "Authorization": "Bearer ${api_key}"
  },
  "body": {
    "model": "${model}",
    "input": "${messages}",
    "temperature": "${temperature}",
    "max_output_tokens": "${max_output_tokens}",
    "stream": "${stream}",
    "store": false
  },
  "models": {
    "endpoint": "/models",
    "response_models_pointer": "/data",
    "response_model_id": "id"
  },
  "streaming": {
    "transport": "sse",
    "endpoint": "/responses",
    "request_body": {}
  },
  "reasoning_effort": {
    "body_pointer": "/reasoning/effort",
    "values": [
      "none",
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "aliases": []
  },
  "response_format": "responses"
}
