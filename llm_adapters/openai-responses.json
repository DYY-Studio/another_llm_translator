{
  "schema_version": 1,
  "adapter_id": "openai-responses",
  "headers": {
    "Authorization": "Bearer ${api_key}"
  },
  "body": {
    "model": "${model}",
    "input": "${messages}",
    "temperature": "${temperature}",
    "max_output_tokens": "${max_output_tokens}",
    "stream": "${stream}",
    "store": false
  },
  "response_content_pointer": "/output_text"
}
