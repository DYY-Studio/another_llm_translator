{
  "schema_version": 3,
  "adapter_id": "chatgpt-plan",
  "endpoint": "/responses",
  "headers": {
    "Authorization": "Bearer ${api_key}"
  },
  "body": {
    "model": "${model}",
    "input": "${messages}",
    "stream": true,
    "store": false
  },
  "response_content_pointer": "/output/-1/content/-1/text",
  "response_finish_reason_pointer": "/incomplete_details/reason",
  "truncated_finish_reasons": ["max_output_tokens"],
  "blocked_finish_reasons": ["content_filter"],
  "models": {
    "endpoint": "/models",
    "response_models_pointer": "/models",
    "response_model_id": "slug",
    "response_model_display": "display_name"
  },
  "usage": {
    "input_tokens_pointer": "/usage/input_tokens",
    "output_tokens_pointer": "/usage/output_tokens",
    "total_tokens_pointer": "/usage/total_tokens"
  },
  "streaming": {
    "transport": "sse",
    "endpoint": "/responses",
    "request_body": {},
    "content_events": [
      {
        "pointer": "/delta",
        "when": {
          "pointer": "/type",
          "equals": "response.output_text.delta"
        }
      }
    ],
    "reasoning_events": [],
    "finish_reason_events": [{"pointer": "/response/incomplete_details/reason"}],
    "terminal": {
      "when": {
        "pointer": "/type",
        "equals": "response.completed"
      }
    },
    "error_events": [
      {
        "when": {
          "pointer": "/type",
          "equals": "error"
        },
        "message_pointer": "/message"
      },
      {
        "when": {
          "pointer": "/type",
          "equals": "response.failed"
        },
        "message_pointer": "/response/error/message"
      }
    ],
    "usage": {
      "input_tokens_pointers": [
        "/response/usage/input_tokens"
      ],
      "output_tokens_pointers": [
        "/response/usage/output_tokens"
      ],
      "total_tokens_pointers": [
        "/response/usage/total_tokens"
      ]
    }
  },
  "messages_format": "responses",
  "connection": {
    "base_url": "https://api.openai.com/v1",
    "credential": {
      "kind": "chatgpt",
      "name": "default"
    },
    "proxy_source": "connection"
  }
}
