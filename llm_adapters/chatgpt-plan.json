{
  "schema_version": 4,
  "adapter_id": "chatgpt-plan",
  "endpoint": "/responses",
  "headers": {
    "Authorization": "Bearer ${api_key}"
  },
  "body": {
    "model": "${model}",
    "input": "${messages}",
    "stream": true,
    "store": false
  },
  "models": {
    "endpoint": "/models",
    "response_models_pointer": "/models",
    "response_model_id": "slug",
    "response_model_display": "display_name"
  },
  "streaming": {
    "transport": "sse",
    "endpoint": "/responses",
    "request_body": {}
  },
  "messages_format": "responses",
  "connection": {
    "base_url": "https://api.openai.com/v1",
    "credential": {
      "kind": "chatgpt",
      "name": "default"
    },
    "proxy_source": "connection"
  },
  "reasoning_effort": {
    "body_pointer": "/reasoning/effort",
    "values": [
      "none",
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "aliases": []
  },
  "response_format": "responses",
  "structured_output": {
    "/text/format": {
      "type": "json_schema",
      "name": "structured_response",
      "strict": true,
      "schema": "${json_schema}"
    }
  }
}
