{
  "schema_version": 1,
  "adapter_id": "google-gemini",
  "messages_format": "gemini",
  "headers": {
    "x-goog-api-key": "${api_key}"
  },
  "body": {
    "system_instruction": {
      "parts": [
        {
          "text": "${system}"
        }
      ]
    },
    "contents": "${messages}",
    "generationConfig": {
      "temperature": "${temperature}",
      "maxOutputTokens": "${max_output_tokens}"
    }
  },
  "response_content_pointer": "/candidates/0/content/parts/-1/text",
  "models": {
    "endpoint": "/models",
    "response_models_pointer": "/models",
    "response_model_id": "name",
    "response_model_display": "displayName",
    "response_model_strip_prefix": "models/"
  },
  "usage": {
    "input_tokens_pointer": "/usageMetadata/promptTokenCount",
    "output_tokens_pointer": "/usageMetadata/candidatesTokenCount",
    "total_tokens_pointer": "/usageMetadata/totalTokenCount"
  }
}
