{
  "schema_version": 4,
  "adapter_id": "google-gemini",
  "endpoint": "/models/${model}:generateContent",
  "messages_format": "gemini",
  "headers": {
    "x-goog-api-key": "${api_key}"
  },
  "body": {
    "system_instruction": {
      "parts": [
        {
          "text": "${system}"
        }
      ]
    },
    "contents": "${messages}",
    "generationConfig": {
      "temperature": "${temperature}",
      "maxOutputTokens": "${max_output_tokens}"
    }
  },
  "models": {
    "endpoint": "/models",
    "response_models_pointer": "/models",
    "response_model_id": "name",
    "response_model_display": "displayName",
    "response_model_strip_prefix": "models/"
  },
  "streaming": {
    "transport": "sse",
    "endpoint": "/models/${model}:streamGenerateContent?alt=sse",
    "request_body": {}
  },
  "reasoning_effort": {
    "body_pointer": "/generationConfig/thinkingConfig/thinkingLevel",
    "values": [
      "MINIMAL",
      "LOW",
      "MEDIUM",
      "HIGH"
    ],
    "aliases": []
  },
  "response_format": "gemini"
}
